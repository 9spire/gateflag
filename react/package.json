{
  "name": "gateflag",
  "version": "0.1.1",
  "description": "React feature-flag and access-control components for Gateflag",
  "license": "MIT",
  "author": "Rebecca Dittmar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9spire/gateflag.git",
    "directory": "react"
  },
  "homepage": "https://9spire.github.io/gateflag/",
  "bugs": {
    "url": "https://github.com/9spire/gateflag/issues"
  },
  "keywords": [
    "feature-flags",
    "access-control",
    "react",
    "gateflag",
    "permissions"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && tailwindcss -i ./src/forms-plugin.css -o ./dist/forms-plugin.css && node ./scripts/merge-form-classes.mjs && rm ./dist/forms-plugin.css",
    "build": "npm run build:js && npm run build:css"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@gateflag/core": "*",
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^31.0.0",
    "msw": "^2.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
